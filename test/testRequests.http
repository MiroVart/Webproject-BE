### Get dishes
GET {{apiUrl}}/dishes

### Get dish by id
GET {{apiUrl}}/dishes/14

### Post new dish
POST {{apiUrl}}/dishes
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
    "dish_name_en": "Porkchop with potatoes",
    "dish_name_fi": "Porsaankyljys perunoilla",
    "type": "main",
    "weekday": "wed",
    "price": 6.99,
    "calories": 500,
    "carbs": 50,
    "fat": 10,
    "saturated_fat": 10,
    "protein": 10,
    "fiber": 10,
    "allergens_en": "",
    "allergens_fi": "",
    "description_en": "",
    "description_fi": "",
    "filename": "",
    "available": true
}

### post dish WITH IMAGE
POST {{apiUrl}}/dishes HTTP/1.1
Authorization: Bearer {{login.response.body.token}}
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="dish_name_en"

Porkchop with potatoes
--MyBoundary
Content-Disposition: form-data; name="dish_name_fi"

Porsaankyljys perunoilla
--MyBoundary
Content-Disposition: form-data; name="type"

main
--MyBoundary
Content-Disposition: form-data; name="weekday"

mon
--MyBoundary
Content-Disposition: form-data; name="price"

6.99
--MyBoundary
Content-Disposition: form-data; name="filename"

img-placeholder
--MyBoundary
Content-Disposition: form-data; name="picture"; filename="IMG_20240825_145643.jpg"
Content-Type: image/jpeg

< ./IMG_20240825_145643.jpg
--MyBoundary--

### Edit dish
PUT {{apiUrl}}/dishes/14
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
    "dish_name_en": "Porkchop with potatoes",
    "dish_name_fi": "Porsaankyljys perunoilla",
    "type": "main",
    "weekday": "fri",
    "price": 6.99,
    "calories": 500,
    "carbs": 50,
    "fat": 10,
    "saturated_fat": 10,
    "protein": 10,
    "fiber": 10,
    "filename": "file"
}

### Delete dish
DELETE {{apiUrl}}/dishes/10
Authorization: Bearer {{login.response.body.token}}

### Get orders
GET {{apiUrl}}/orders

### Get order by id
GET {{apiUrl}}/orders/4

### Get order by user id
GET {{apiUrl}}/orders/user/4
Authorization: Bearer {{login.response.body.token}}

### Post new order
POST {{apiUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
    "items": [
        {"dishes_id": 2, "dish_amount": 3},
        {"dishes_id": 3, "dish_amount": 2},
        {"dishes_id": 4, "dish_amount": 1}
    ]
}

### Modify order
PUT {{apiUrl}}/orders/11
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "dish_amount": 2,
  "finished": 1,
  "pickedup": 1
}

### Delete order
DELETE {{apiUrl}}/orders/11
Authorization: Bearer {{login.response.body.token}}
